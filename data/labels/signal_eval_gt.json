{
 "about": "D0·D1·D2 신호 판정 비교용 정답 (#15). 직접 촬영한 세로 영상 12개, 1초에 1장씩 사람이 표시. 영상 자체는 저장소에 없음.",
 "how_to_read": {
  "sec": "영상 시작부터 몇 초째인지 (0부터). 그 1초 안의 프레임은 같은 정답으로 본다",
  "state": "red = 위 칸 빨간 사람 켜짐 / green = 가운데 칸 초록 사람 켜짐 / off = 둘 다 꺼짐",
  "box": "우리가 건널 보행 신호등 몸체 [x, y, w, h], 원본 1080x1920 픽셀 기준",
  "blink_sec": "남은 시간 숫자가 나오는 구간 [시작초, 끝초]. 이 안의 정답은 점멸(blink)로 바꿔 green·off 둘 다 맞힌 것으로 본다",
  "split": "장소 단위 분할. dev = 개발 중 본 장소(A·C), test = 처음 보는 장소(B·D)"
 },
